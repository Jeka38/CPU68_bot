BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE
# UI language: ru (default) or en. Catalogs live in locales/.
LANGUAGE=ru
# Telegram user IDs allowed to use /a* admin commands (comma-separated).
# Get your ID with /id in the group.
ADMIN_IDS=PASTE_YOUR_TELEGRAM_ID
# Where unhandled errors are sent in private messages (comma-separated).
# Empty = use ADMIN_IDS. Every listed admin must press /start in the bot DM.
ERROR_REPORT_IDS=
# Minimum seconds between identical error reports (default 300).
ERROR_NOTIFY_COOLDOWN_SECONDS=300
# Optional: group chat IDs for the whitelist (comma-separated, negative).
# The bot serves ONLY listed groups; an empty whitelist disables it in all groups.
# Applied once on the first start; afterwards groups are managed with
# /agroup add|del|list and stored in the DB (allowed_chats table).
ALLOWED_CHAT_IDS=
# Anti-spam: minimum seconds between counted messages from one user in one chat.
MESSAGE_COOLDOWN_SECONDS=2
# Anti-spam: minimum seconds between public commands from one user in one chat.
COMMAND_COOLDOWN_SECONDS=3
# Optional for local runs. In Docker this is overridden to /data/users.db.
# DB_PATH=users.db
